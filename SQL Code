-- ====================================================================
-- DATABASE INFRASTRUCTURE RESET & REALTIME SETUP
-- Role: Drops existing structures, rebuilds tables, and links Realtime.
-- ====================================================================

-- 1. Clean up old table configurations to prevent memory leaks or schema conflicts
DROP TABLE IF EXISTS messages;
DROP TABLE IF EXISTS users;

-- 2. Build User table equipped with Custom Operator Display Name
CREATE TABLE users (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    username TEXT UNIQUE NOT NULL,      -- Login identity identifier
    password TEXT NOT NULL,             -- Plain authentication credential
    display_name TEXT NOT NULL,         -- Custom chat nickname used across the network
    discord_id TEXT NOT NULL,           -- Unique Discord Snowflake ID for avatar fetching
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 3. Build Central Message Matrix mirroring live Discord activities
CREATE TABLE messages (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    message_id TEXT UNIQUE NOT NULL,
    channel_id TEXT NOT NULL,
    username TEXT NOT NULL,             -- Displays Custom Display Name or Discord Profile Nickname
    content TEXT,
    is_discord BOOLEAN DEFAULT TRUE,
    avatar_url TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 4. Force inject message table into the core Supabase Realtime broadcast layer
ALTER PUBLICATION supabase_realtime ADD TABLE messages;
